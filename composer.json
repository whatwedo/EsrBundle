{
    "name": "whatwedo/esr-bundle",
    "type": "symfony-bundle",
    "description": "Symfony4 bundle for creating orange inpayment slip PDF's",
    "license": "MIT",
    "keywords": ["postfinance", "e-payment", "esr", "ips", "qr-invoice"],
    "homepage": "https://github.com/whatwedo/EsrBundle",
    "authors": [
        {
            "name": "Ueli Banholzer",
            "email": "ueli@whatwedo.ch",
            "homepage": "https://whatwedo.ch"
        },
        {
            "name": "Maurizio Monticelli",
            "email": "maurizio@whatwedo.ch"
        },
        {
            "name": "Nicolo Singer",
            "email": "nicolo@whatwedo.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "whatwedo\\EsrBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.0",
        "knplabs/knp-snappy-bundle": "^1.5",
        "sprain/swiss-qr-bill": "^4.13|^5.0",
        "symfony/config": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/mime": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/twig-bridge": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/validator": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/yaml": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "twig/twig": "^2.13|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.2",
        "symfony/framework-bundle": "^4.4|^5.4|^6.4|^7.0|^8.0",
        "symfony/security-csrf": "^4.4|^5.4|^6.4|^7.0|^8.0"
    },
    "config": {
        "sort-packages": true
    }
}
